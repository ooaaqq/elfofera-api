{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableRateLimiting"],
  "enabledManagers": ["bun", "bun-version", "cargo", "github-actions"],
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["@react-spectrum/s2"],
      "groupName": "React Spectrum S2",
      "ignoreUnstable": false
    },
    {
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "React"
    },
    {
      "matchPackageNames": ["bun"],
      "groupName": "Bun runtime"
    }
  ]
}
