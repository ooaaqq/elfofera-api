{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "maxSize": 2097152,
    "includes": [
      "test/**",
      "scripts/**",
      "*.{js,jsx,ts,tsx,json,jsonc}",
      "!node_modules",
      "!.local",
      "!.direnv",
      "!dist",
      "!**/dist",
      "!coverage",
      "!.git",
      "!migrations/meta"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "style": {
        "noNestedTernary": "error",
        "noParameterAssign": "error"
      },
      "suspicious": {
        "useAwait": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
