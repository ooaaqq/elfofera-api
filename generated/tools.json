          ]
        },
        "workId": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "from",
        "through",
        "member",
        "limit",
        "offset",
        "workId"
      ],
      "additionalProperties": false
    }
  },
