[
  {
    "name": "elfofera_timeline",
    "description": "查询日期范围的活动、计划、变更、录播和表演。相对日期按 Asia/Shanghai 计算。全体成员一次查询；问歌单时包含 performances。资料仅覆盖已确认记录，空结果不能证明从未发生。回答保留来源或录播链接，区分计划与实际，不能把上传者当成演唱者。未知原唱与不使用的筛选填 null，不猜测。",
    "path": "/v1/timeline",
    "pathParameters": [],
    "parameters": {
      "type": "object",
      "properties": {
        "from": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "through": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "member": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "luzao",
                "youen",
                "yumo",
                "waner",
                "minuo"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "include": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "from",
        "through",
        "member",
        "include"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "elfofera_search_works",
    "description": "按歌名或原唱搜索作品。未明确原唱填 artist=null；先搜索获取真实 workId，同名作品先核对原唱和来源。资料仅覆盖已确认记录，空结果不能证明从未发生。回答保留来源或录播链接，区分计划与实际，不能把上传者当成演唱者。未知原唱与不使用的筛选填 null，不猜测。",
    "path": "/v1/works",
    "pathParameters": [],
    "parameters": {
      "type": "object",
      "properties": {
        "q": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "artist": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "q",
        "artist",
        "limit",
        "offset"
      ],
      "additionalProperties": false
    }
  },
  {
