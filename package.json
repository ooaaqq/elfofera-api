{
  "name": "elfofera-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "cargo run --locked -- serve --snapshot dist/archive.json",
    "build": "cargo run --locked -- build",
    "start": "cargo run --locked --release -- serve --snapshot dist/archive.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings && cargo test --locked && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm frontend:build",
    "deps:outdated": "pnpm outdated",
    "frontend:data": "node frontend/build-data.mjs",
    "frontend:dev": "pnpm build && pnpm frontend:data && vite frontend --host 127.0.0.1 --port 4173",
    "frontend:build": "pnpm frontend:data && vite build frontend",
    "frontend:preview": "vite preview frontend --host 127.0.0.1 --port 4174 --strictPort"
  },
  "dependencies": {
    "@carbon/icons-react": "11.91.0",
    "@carbon/react": "1.119.0",
    "@ibm/plex-sans": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "sass": "1.106.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
