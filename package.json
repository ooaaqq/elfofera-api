{
  "name": "elfofera-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write --error-on-warnings .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx/esm src/db/migrate.ts",
    "db:import:confirmed": "node --env-file-if-exists=.env.local --import tsx/esm src/db/import.ts",
    "deps:outdated": "pnpm outdated",
    "frontend:data": "node frontend/build-data.mjs",
    "frontend:dev": "pnpm frontend:data && vite frontend --host 127.0.0.1 --port 4173",
    "frontend:build": "pnpm frontend:data && vite build frontend",
    "frontend:preview": "vite preview frontend --host 127.0.0.1 --port 4174 --strictPort",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@carbon/icons-react": "11.91.0",
    "@carbon/react": "1.119.0",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@ibm/plex-sans": "1.1.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "sass": "1.106.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
