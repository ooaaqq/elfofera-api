{
  "name": "elfofera-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "pnpm build && tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json && node dist/build.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write --error-on-warnings .",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "deps:outdated": "pnpm outdated",
    "frontend:data": "pnpm build && node frontend/build-data.mjs",
    "frontend:dev": "pnpm frontend:data && vite frontend --host 127.0.0.1 --port 4173",
    "frontend:build": "pnpm frontend:data && vite build frontend",
    "frontend:preview": "vite preview frontend --host 127.0.0.1 --port 4174 --strictPort"
  },
  "dependencies": {
    "@carbon/icons-react": "11.91.0",
    "@carbon/react": "1.119.0",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@ibm/plex-sans": "1.1.0",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "sass": "1.106.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
