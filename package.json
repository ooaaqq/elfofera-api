{
  "name": "elfofera-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "cargo run --locked -- serve --snapshot dist/archive.json",
    "build": "cargo run --locked -- build && cargo run --locked -- contract --output dist",
    "start": "cargo run --locked --release -- serve --snapshot dist/archive.json",
    "lint": "bun --bun biome check --error-on-warnings .",
    "format": "bun --bun biome check --write --error-on-warnings .",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test",
    "check": "cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings && cargo test --locked && bun run lint && bun run typecheck && bun run build && bun run frontend:build && bun run test",
    "deps:outdated": "bun outdated",
    "frontend:data": "bun scripts/build-frontend.mjs",
    "frontend:dev": "bun --bun vite frontend --config vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "frontend:build": "bun run frontend:data && bun --bun vite build frontend --config vite.config.ts",
    "frontend:preview": "bun --bun vite preview frontend --config vite.config.ts --host 127.0.0.1 --port 4174 --strictPort"
  },
  "dependencies": {
    "@react-spectrum/s2": "1.8.2",
    "@tanstack/react-query": "5.105.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "6.4.1"
  },
  "trustedDependencies": []
}
